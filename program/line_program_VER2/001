"""Collect a small sample of WINTICKET racecard HTML."""

import re
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urljoin, urlsplit

import requests
from bs4 import BeautifulSoup


BASE_URL = "https://www.winticket.jp/keirin/"
RACECARD_URL = "https://www.winticket.jp/keirin/racecard/"
USER_AGENT = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
    "AppleWebKit/537.36 (KHTML, like Gecko) "
    "Chrome/142.0.0.0 Safari/537.36 Edg/142.0.0.0"
)

# 最初は少数のレースだけで接続を確認する。
# 全レースを取得する場合は None に変更する。
MAX_RACES = 3
REQUEST_INTERVAL = 0.5
TIMEOUT = 30
RETRIES = 3

RETRY_STATUSES = {429, 500, 502, 503, 504}

# 例: /keirin/keiokaku/racecard/2026102627/1/1
RACE_PATH_RE = re.compile(
    r"^/keirin/(?P<venue_slug>[^/]+)/racecard/"
    r"(?P<event_id>\d{10})/(?P<day>\d+)/(?P<race_no>\d+)/?$"
)


def get_html(session, url, referer):
    """公開ページを取得。403は再試行せず、そのままエラーにする。"""
    for attempt in range(1, RETRIES + 1):
        try:
            response = session.get(
                url,
                headers={"Referer": referer},
                timeout=TIMEOUT,
            )
        except requests.RequestException:
            if attempt == RETRIES:
                raise
            time.sleep(min(2 ** attempt, 8))
            continue

        if response.status_code == 403:
            raise requests.HTTPError(
                f"WINTICKET returned HTTP 403 for {response.url}",
                response=response,
            )

        if response.status_code in RETRY_STATUSES:
            if attempt == RETRIES:
                response.raise_for_status()
            time.sleep(min(2 ** attempt, 8))
            continue

        response.raise_for_status()

        content_type = response.headers.get("Content-Type", "").lower()
        if "html" not in content_type:
            raise RuntimeError(
                f"HTML以外の応答です: {response.url} "
                f"(Content-Type: {content_type or 'unknown'})"
            )

        # 文字コードが応答ヘッダーにない場合に備える。
        if not response.encoding or response.encoding.lower() == "iso-8859-1":
            response.encoding = response.apparent_encoding or "utf-8"

        html = response.text
        if not re.search(r"<html[\s>]", html, flags=re.IGNORECASE):
            raise RuntimeError(f"HTMLページとして判定できません: {response.url}")

        if REQUEST_INTERVAL > 0:
            time.sleep(REQUEST_INTERVAL)

        return html

    raise RuntimeError(f"ページを取得できませんでした: {url}")


def find_today_races(index_html, target_date):
    """一覧ページから対象日付のレース詳細URLを探す。"""
    races = {}
    soup = BeautifulSoup(index_html, "html.parser")

    for anchor in soup.find_all("a", href=True):
        url = urljoin(RACECARD_URL, anchor["href"])
        parsed = urlsplit(url)

        if parsed.netloc not in {"www.winticket.jp", "winticket.jp"}:
            continue

        match = RACE_PATH_RE.match(parsed.path)
        if not match:
            continue

        event_id = match.group("event_id")
        race_date = event_id[:8]
        venue_code = event_id[8:10]
        race_no = int(match.group("race_no"))

        if race_date != target_date:
            continue

        # 019と同じ形式: YYYYMMDD_場コード_レース番号
        race_key = f"{race_date}_{venue_code}_{race_no:02d}"
        races[race_key] = url

    return sorted(races.items(), key=lambda item: item[0])


def collect_html(target_date, output_file):
    session = requests.Session()
    session.headers.update({
        "User-Agent": USER_AGENT,
        "Accept": (
            "text/html,application/xhtml+xml,application/xml;"
            "q=0.9,*/*;q=0.8"
        ),
        "Accept-Language": "ja-JP,ja;q=0.9,en-US;q=0.8,en;q=0.7",
        "Upgrade-Insecure-Requests": "1",
    })

    # 通常のページ遷移に近い順序でアクセスする。
    get_html(session, BASE_URL, referer=BASE_URL)
    index_html = get_html(
        session,
        RACECARD_URL,
        referer=BASE_URL,
    )

    races = find_today_races(index_html, target_date)
    if not races:
        raise RuntimeError(
            f"{target_date} のレースURLが見つかりませんでした。"
            "一覧ページのURL形式が変わっている可能性があります。"
        )

    selected_races = races
    if MAX_RACES is not None:
        selected_races = races[:MAX_RACES]

    output_lines = [
        "<!-- =============================================== -->",
        f"<!-- DATE={target_date} -->",
        "<!-- SOURCE=WINTICKET RaceCard -->",
        "<!-- GENERATED BY test_collect_winticket_lines_html.py -->",
        "<!-- =============================================== -->",
        "",
    ]

    for index, (race_key, race_url) in enumerate(selected_races, start=1):
        race_html = get_html(
            session,
            race_url,
            referer=RACECARD_URL,
        )

        output_lines.extend([
            f"<!-- RACE_KEY={race_key} -->",
            race_html,
            "<!-- END_RACE -->",
            "",
        ])
        print(f"[{index}/{len(selected_races)}] fetched {race_key}")

    output_file = Path(output_file)
    output_file.parent.mkdir(parents=True, exist_ok=True)
    temporary_file = output_file.with_name(output_file.name + ".tmp")
    temporary_file.write_text("\n".join(output_lines), encoding="utf-8")
    temporary_file.replace(output_file)

    print(
        f"保存しました: {output_file} "
        f"(一覧で見つかったレース数={len(races)}, "
        f"取得数={len(selected_races)})"
    )


if __name__ == "__main__":
    jst = timezone(timedelta(hours=9))
    target_date = datetime.now(jst).strftime("%Y%m%d")

    if __import__("os").name == "nt":
        base_dir = Path(r"C:\競輪AI")
    else:
        # このスクリプトを official_program 内に置く想定
        base_dir = Path(__file__).resolve().parent.parent

    output_file = (
        base_dir
        / "data_official"
        / "today"
        / "winticket_test_lines.html"
    )

    print("=" * 70)
    print("WINTICKET HTML access check")
    print("TARGET DATE:", target_date)
    print("MAX RACES:", MAX_RACES)
    print("=" * 70)

    collect_html(target_date, output_file)