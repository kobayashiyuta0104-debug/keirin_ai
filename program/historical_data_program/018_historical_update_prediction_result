import argparse
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

import pandas as pd


# ===========================================================
# 基本設定
# ===========================================================

if os.name == "nt":
    BASE = Path(r"C:\競輪AI")
else:
    BASE = Path(__file__).resolve().parent.parent

PREDICTION_DIR = BASE / "csv" / "prediction"
RESULT_DIR = BASE / "csv" / "result"
JST = timezone(timedelta(hours=9))


# ===========================================================
# 対象日付
# ===========================================================

def get_target_date():
    yesterday = (datetime.now(JST) - timedelta(days=1)).strftime("%Y%m%d")

    parser = argparse.ArgumentParser()
    parser.add_argument(
        "target_date",
        nargs="?",
        help="対象日付（YYYYMMDD）。省略時は昨日。",
    )
    args = parser.parse_args()

    target_date = args.target_date

    # 手動実行時は入力で指定できます。
    # GitHub Actionsなど標準入力がない環境では昨日を使います。
    if not target_date and sys.stdin.isatty():
        entered = input(
            f"対象日付を入力してください（YYYYMMDD、Enterで昨日 {yesterday}）: "
        ).strip()
        target_date = entered or yesterday

    target_date = target_date or yesterday

    try:
        datetime.strptime(target_date, "%Y%m%d")
    except ValueError as exc:
        raise ValueError(
            "対象日付はYYYYMMDD形式で入力してください（例: 20261022）"
        ) from exc

    return target_date


# ===========================================================
# 列名の改行統一と重複列の統合
# ===========================================================

def normalize_prediction_columns(df):
    """
    列名中のCRLF/CRをLFに統一します。
    同じ列名になった列は、先の列が空欄なら後の列の値を採用します。
    """

    merged_columns = {}

    for index, original_name in enumerate(df.columns):
        column_name = (
            str(original_name)
            .replace("\r\n", "\n")
            .replace("\r", "\n")
        )
        values = df.iloc[:, index].copy()

        if column_name not in merged_columns:
            merged_columns[column_name] = values
            continue

        existing = merged_columns[column_name]
        empty_mask = existing.map(
            lambda value: (
                pd.isna(value)
                or (isinstance(value, str) and value.strip() == "")
            )
        )
        merged_columns[column_name] = existing.where(
            ~empty_mask,
            values,
        )

    return pd.DataFrame(merged_columns, index=df.index)


# ===========================================================
# CSV読込
# ===========================================================

def load_prediction(target_date):
    prediction_file = PREDICTION_DIR / f"{target_date}_prediction.csv"

    if not prediction_file.exists():
        raise FileNotFoundError(f"予想CSVが見つかりません: {prediction_file}")

    df = pd.read_csv(
        prediction_file,
        encoding="utf-8-sig",
        low_memory=False,
    )

    original_column_count = len(df.columns)
    df = normalize_prediction_columns(df)

    print(f"予想CSV: {prediction_file}")
    print(f"行数: {len(df):,}")
    print(f"列数: {original_column_count} → {len(df.columns)}")

    return df, prediction_file


def load_result(target_date):
    result_file = RESULT_DIR / f"{target_date}_result.csv"

    if not result_file.exists():
        raise FileNotFoundError(f"結果CSVが見つかりません: {result_file}")

    df = pd.read_csv(
        result_file,
        encoding="utf-8-sig",
        low_memory=False,
    )

    print(f"結果CSV: {result_file}")
    print(f"行数: {len(df):,}")

    return df


# ===========================================================
# 払戻クラス判定
# ===========================================================

def get_result_class(payout):
    if payout <= 1999:
        return "0～1,999円"
    elif payout <= 4999:
        return "2,000～4,999円"
    elif payout <= 9999:
        return "5,000～9,999円"
    elif payout <= 19999:
        return "10,000～19,999円"
    elif payout <= 29999:
        return "20,000～29,999円"
    elif payout <= 49999:
        return "30,000～49,999円"
    elif payout <= 99999:
        return "50,000～99,999円"
    else:
        return "100,000円以上"


# ===========================================================
# 予想CSV更新
# ===========================================================

def update_prediction(prediction_df, result_df):
    required_prediction = ["レースキー", "AI予想"]
    required_result = [
        "race_key",
        "trifecta_payout",
        "finish_order",
        "car_no",
    ]

    missing_prediction = [
        column for column in required_prediction
        if column not in prediction_df.columns
    ]
    missing_result = [
        column for column in required_result
        if column not in result_df.columns
    ]

    if missing_prediction:
        raise ValueError(f"予想CSVに必要な列がありません: {missing_prediction}")
    if missing_result:
        raise ValueError(f"結果CSVに必要な列がありません: {missing_result}")

    # 結果欄がないCSVでも列を用意します。
    output_columns = [
        "三連単\n払戻",
        "実際\nクラス",
        "的中\n判定",
        "１着",
        "２着",
        "３着",
    ]
    for column in output_columns:
        if column not in prediction_df.columns:
            prediction_df[column] = ""

    prediction_df["レースキー"] = (
        prediction_df["レースキー"].fillna("").astype(str).str.strip()
    )
    result_df["race_key"] = (
        result_df["race_key"].fillna("").astype(str).str.strip()
    )
    result_df["finish_order"] = pd.to_numeric(
        result_df["finish_order"],
        errors="coerce",
    )
    result_df["car_no"] = pd.to_numeric(
        result_df["car_no"],
        errors="coerce",
    )

    for column in output_columns:
        prediction_df[column] = prediction_df[column].astype(object)

    update_count = 0
    matched_keys = 0

    for race_key in prediction_df["レースキー"].drop_duplicates():
        if not race_key:
            continue

        race_result = result_df[result_df["race_key"] == race_key]
        if race_result.empty:
            continue

        matched_keys += 1

        payout_values = race_result["trifecta_payout"].dropna()
        payout_values = payout_values[
            payout_values.astype(str).str.strip() != ""
        ]

        if payout_values.empty:
            continue

        payout_text = str(payout_values.iloc[0]).replace(",", "").strip()

        try:
            payout = int(float(payout_text))
        except (TypeError, ValueError):
            continue

        prediction_mask = prediction_df["レースキー"] == race_key
        result_class = get_result_class(payout)

        prediction_df.loc[prediction_mask, "三連単\n払戻"] = payout
        prediction_df.loc[prediction_mask, "実際\nクラス"] = result_class

        ai_class = prediction_df.loc[prediction_mask, "AI予想"].iloc[0]
        prediction_df.loc[prediction_mask, "的中\n判定"] = (
            "○" if ai_class == result_class else "×"
        )

        order_columns = {
            1: "１着",
            2: "２着",
            3: "３着",
        }

        for order, output_column in order_columns.items():
            finish_rows = race_result[
                race_result["finish_order"] == order
            ]

            if finish_rows.empty or pd.isna(finish_rows["car_no"].iloc[0]):
                continue

            prediction_df.loc[prediction_mask, output_column] = int(
                finish_rows["car_no"].iloc[0]
            )

        update_count += 1

    print(f"結果キー一致数: {matched_keys:,}")
    print(f"払戻を反映したレース数: {update_count:,}")

    return prediction_df


# ===========================================================
# CSV保存
# ===========================================================

def save_prediction(prediction_df, prediction_file):
    prediction_df.to_csv(
        prediction_file,
        index=False,
        encoding="utf-8-sig",
        lineterminator="\n",
    )

    print(f"保存先: {prediction_file}")


# ===========================================================
# Main
# ===========================================================

def main():
    target_date = get_target_date()
    print(f"対象日付: {target_date}")

    prediction_df, prediction_file = load_prediction(target_date)
    result_df = load_result(target_date)

    prediction_df = update_prediction(
        prediction_df,
        result_df,
    )

    save_prediction(
        prediction_df,
        prediction_file,
    )

    print("完了")


if __name__ == "__main__":
    main()